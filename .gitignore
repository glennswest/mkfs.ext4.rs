# Secrets and environment
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build artifacts
target/
dist/
build/

# Logs and temp
*.log
tmp/
temp/

# Filesystem images produced by tests and manual runs
*.img
*.img.*

# slidemaker production artifacts (regenerable from the deck + narration)
docs/presentation/frames/
docs/presentation/segs/
docs/presentation/tts/
docs/presentation/voice-*/
docs/presentation/concat.txt
docs/presentation/*.mp4
docs/presentation/*.wav
docs/presentation/*.m4a

# The golden mke2fs reference images are vendored on purpose: the
# comparison tests are meaningless without them, and a fresh clone must
# be able to run them. The blanket *.img.* above must not catch them.
!tests/golden/*.img.gz
